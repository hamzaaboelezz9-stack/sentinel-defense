# Export these in your shell; no automatic dotenv loading.
SENTINEL_DEMO=1
DEMO_PASSWORD=replace-with-a-unique-long-passphrase
DATABASE_URL=sqlite:///sentinel.db
SECURE_COOKIES=0
PORT=8000
SENTINEL_SESSION_SECONDS=3600
SENTINEL_REQUESTS_PER_MINUTE=240
SENTINEL_RETENTION_DAYS=90
SENTINEL_MAX_BATCH=1000
# PostgreSQL Compose requires a URL-safe password, supplied outside Git.
POSTGRES_PASSWORD=replace-with-a-unique-url-safe-passphrase
